# SQLite (default, siap pakai lokal)
DATABASE_URL="file:./dev.db"

# Auth.js / NextAuth — wajib untuk Google OAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-acak"
AUTH_URL="http://localhost:3000"

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email Google yang mendapat role ADMIN (pisahkan koma jika lebih dari satu)
ADMIN_EMAILS="you@gmail.com"

# Rekening & e-wallet toko
BCA_ACCOUNT_NUMBER="8881234567"
BCA_ACCOUNT_NAME="Nexora Store"
DANA_PHONE="081234567890"
DANA_NAME="Nexora Store"

# Versi publik (dibaca di halaman checkout client)
NEXT_PUBLIC_BCA_ACCOUNT_NUMBER="8881234567"
NEXT_PUBLIC_BCA_ACCOUNT_NAME="Nexora Store"
NEXT_PUBLIC_DANA_PHONE="081234567890"
NEXT_PUBLIC_DANA_NAME="Nexora Store"
